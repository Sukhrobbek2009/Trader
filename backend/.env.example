# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# Optional
# PRICE_REFRESH_SECONDS=45          # clamped to 30-60
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# COOKIE_SECURE=1                   # set when served over HTTPS
# Bots trade while their status is "running"; no env switch needed.
# BOT_TIMEFRAME_HOURS=1             # candle size, minimum 1
# BOT_TICK_SECONDS=45               # how often running bots are ticked (minimum 10)
